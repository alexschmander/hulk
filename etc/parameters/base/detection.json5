{
  enable: true,
  neural_networks_folder: "etc/neural_networks",
  model_name: "hydra-native.onnx",
  object_detection_parameters: {
    maximum_intersection_over_union: 0.4,
    minimum_candidate_confidence: 0.05,
  },
  pose_detection_parameters: {
    maximum_intersection_over_union: 0.5,
    minimum_candidate_confidence: 0.5,
  },
  robot_pose_detection_parameters: {
    maximum_intersection_over_union: 0.5,
    minimum_candidate_confidence: 0.5,
  },
  field_feature_detection_parameters: {
    minimum_candidate_confidence: 0.35,
    maximum_suppression_distance_in_pixels: 8.0,
  },
  hydra_line_detection_parameters: {
    minimum_candidate_confidence: 0.39,
  },
}
